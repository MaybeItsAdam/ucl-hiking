# TEMPORARY roster sync: plain HTTP, so no Chromium and no `suu` install.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/job/src

WORKDIR /job
# tzdata: the slim image has no system zoneinfo, and end dates are read in Europe/London.
RUN pip install --no-cache-dir "httpx>=0.28,<1" "tzdata>=2024.1"
COPY src/hiking_sync/__init__.py src/hiking_sync/suu_session.py src/hiking_sync/roster_sync.py ./src/hiking_sync/

USER 65532:65532
ENTRYPOINT ["python", "-m", "hiking_sync.roster_sync"]
