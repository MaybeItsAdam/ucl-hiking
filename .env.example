# Register every domain that serves this app as a bare origin in Adam's Campus
# Toolbox under the Hiking organiser's allowed sites. Browser sign-in returns
# to the origin from which it started; the native shell uses CAPACITOR_APP_URL.
# Current: https://ucl-hiking.vercel.app
# Future, after the domain points to this deployment: https://uclhiking.org

# Display name used in sign-in copy and Toolbox handoff.
NEXT_PUBLIC_SOCIETY_NAME=UCL Hiking Club

# Contact for privacy requests. Use an address monitored by MaybeItsSoftware.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@uclhiking.org

# Shared UCL identity provider. No Entra secret belongs in this app.
NEXT_PUBLIC_TOOLBOX_URL=https://www.adamscampustoolbox.org.uk
TOOLBOX_URL=https://www.adamscampustoolbox.org.uk
# Leave false for comparison-only runs. Set true only after the ACT identity
# links and at least seven daily shadow comparisons have been checked.
TOOLBOX_MEMBERS_AUTHORITATIVE=false

# Hiking's own Supabase project. Server-only, and the only key that reaches
# these tables: every table enables RLS and revokes all grants from anon, with
# no policies, because identity is Toolbox rather than Supabase Auth. A
# publishable/anon key can read nothing here, so the app does not accept one.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# At least 32 random characters. Used only to sign Hiking's HttpOnly session.
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-value

# Separate secret presented by the Google Cloud roster sync job. Must match the
# value set on the Cloud Run Job, or every sync POST is rejected with 401.
#   openssl rand -base64 48
MEMBER_SYNC_SECRET=replace-with-another-long-random-value

# HMAC secret for /api/webhooks/toolbox, issued by the Toolbox Dev Portal when
# the webhook endpoint is registered. Required in production: without it the
# route refuses deliveries rather than accepting unsigned writes.
TOOLBOX_WEBHOOK_SECRET=whsec_...

# Daily event and membership reconciles. The Dev Portal account and token need
# EVENTS_READ and MEMBERS_READ on the Hiking organiser; MEMBERS_READ is a
# sensitive, explicit grant and is not added to existing tokens automatically.
TOOLBOX_API_TOKEN=act_live_...
TOOLBOX_ORGANISER_ID=org_clu_86a5ecidh

# Vercel Cron sends this as a Bearer token to the reconcile route.
#   openssl rand -base64 48
CRON_SECRET=

# Origin the sync job posts its snapshot back to. Set to the deployed URL.
HIKING_WEB_URL=http://localhost:3000
# Public origin used in calendar feed links (falls back to HIKING_WEB_URL).
NEXT_PUBLIC_APP_URL=https://ucl-hiking.vercel.app

# Runs the Python sync job in-process on this machine. Never set in production;
# outside development the trigger route only enqueues work for the cloud job.
ENABLE_LOCAL_SYNC_EXEC=false

# Students' Union portal session, normally managed from the admin settings screen
# and only read from the environment as a fallback.
SUU_SESSION_ID=
SUU_AUTH_STATE_BASE64=

# Google Cloud project hosting the member sync job.
GCP_PROJECT_ID=ucl-hiking-website
GCP_REGION=europe-west2
GCP_SA_KEY=

# Deployed URL the Capacitor shell loads. Used by `npm run cap:sync` only.
CAPACITOR_APP_URL=https://ucl-hiking.vercel.app

# Google Sheets inventory sync webhook URL and Sheet ID
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_ID=

# Encrypts members' emergency details (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Losing it makes stored details unreadable; changing it needs a re-encrypt.
SAFETY_DATA_KEY=

# Push notifications (Firebase Cloud Messaging HTTP v1). The service account
# JSON, raw or base64. Unset: the in-app inbox still works, nothing is pushed.
FIREBASE_SERVICE_ACCOUNT=
# Lets the phone app register for push. Only set to true once a build that
# includes android/app/google-services.json has shipped: without that file,
# registering crashes the app.
NEXT_PUBLIC_PUSH_ENABLED=
