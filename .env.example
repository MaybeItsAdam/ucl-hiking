# Public URL of this Hiking app. Register this bare origin in Adam's Campus
# Toolbox under the Hiking organiser's allowed sites.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display name used in sign-in copy and Toolbox handoff.
NEXT_PUBLIC_SOCIETY_NAME=UCL Hiking Club

# Shared UCL identity provider. No Entra secret belongs in this app.
NEXT_PUBLIC_TOOLBOX_URL=https://www.adamscampustoolbox.org.uk
TOOLBOX_URL=https://www.adamscampustoolbox.org.uk

# Hiking's own Supabase project. The service-role key is server-only; the
# publishable key is the browser-safe fallback and carries no table grants.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# At least 32 random characters. Used only to sign Hiking's HttpOnly session.
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-value

# Separate secret presented by the Google Cloud roster sync job. Must match the
# value set on the Cloud Run Job, or every sync POST is rejected with 401.
#   openssl rand -base64 48
MEMBER_SYNC_SECRET=replace-with-another-long-random-value

# HMAC secret for /api/webhooks/toolbox, issued by the Toolbox Dev Portal when
# the webhook endpoint is registered. Required in production: without it the
# route refuses deliveries rather than accepting unsigned writes.
TOOLBOX_WEBHOOK_SECRET=whsec_...

# Origin the sync job posts its snapshot back to. Set to the deployed URL.
HIKING_WEB_URL=http://localhost:3000

# Runs the Python sync job in-process on this machine. Never set in production;
# outside development the trigger route only enqueues work for the cloud job.
ENABLE_LOCAL_SYNC_EXEC=false

# Students' Union portal session, normally managed from the admin settings screen
# and only read from the environment as a fallback.
SUU_SESSION_ID=
SUU_AUTH_STATE_BASE64=

# Google Cloud project hosting the member sync job.
GCP_PROJECT_ID=ucl-hiking-website
GCP_REGION=europe-west2
GCP_SA_KEY=

# Deployed URL the Capacitor shell loads. Used by `npm run cap:sync` only.
CAPACITOR_APP_URL=https://hiking.example.org
