# Public URL of this Hiking app. Register this bare origin in Adam's Campus
# Toolbox under the Hiking organiser's allowed sites.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared UCL identity provider. No Entra secret belongs in this app.
NEXT_PUBLIC_TOOLBOX_URL=https://www.adamscampustoolbox.org.uk
TOOLBOX_URL=https://www.adamscampustoolbox.org.uk

# Hiking's own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# At least 32 random characters. Used only to sign Hiking's HttpOnly session.
SESSION_SECRET=replace-with-a-long-random-value

# Separate secret presented by the Google Cloud roster sync job.
MEMBER_SYNC_SECRET=replace-with-another-long-random-value
